# ═══════════════════════════════════════════════════════════════════════════
# Amryn™ AIGrowthIntelligence® — environment
#
# This is the complete list. Three variables, one of them required, and none
# of them needed to run the platform locally.
#
# Copy to .env.local for local development. Set them in the Vercel project
# settings for a deployment.
# ═══════════════════════════════════════════════════════════════════════════


# ─── Session signing ────────────────────────────────────────────────────────
#
# Signs the session cookie. Generate one with:
#
#     openssl rand -base64 32
#
# Required in production, where its absence is a hard error. In development a
# secret is generated per process if this is unset, so the platform runs out of
# the box — but it changes on every restart, which signs you out each time.
#
# Rotating this signs every client out. That is the only revocation mechanism
# the session design has, and it is deliberate: see src/lib/auth/session.ts.

AMRYN_SESSION_SECRET=


# ─── Account storage ────────────────────────────────────────────────────────
#
# Optional, and strongly recommended for any deployment that real people will
# sign up to.
#
# Without these, accounts are held in memory and are lost when the server
# restarts or redeploys. The sign-up page and the Settings page both say so
# rather than letting someone create an account that quietly evaporates.
#
# Create a free Redis database at upstash.com and copy the REST credentials.
# REST rather than a Redis connection string because serverless runtimes cannot
# hold a TCP connection open.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ═══════════════════════════════════════════════════════════════════════════
# Retired — do not reintroduce.
#
# The previous build read the variables below. Nothing in this codebase does.
# If they are still set on a deployment or in a shell profile, remove them, and
# rotate the credentials rather than assuming an unused key is a safe one.
#
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   DATABASE_URL
#   SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD / SMTP_FROM
#   OPENAI_API_KEY
#   ANTHROPIC_API_KEY
#
# See docs-internal/MIGRATION.md.
# ═══════════════════════════════════════════════════════════════════════════
