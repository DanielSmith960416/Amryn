# ──────────────────────────────────────────────────────────────
# Amryn™ AIGrowthIntelligence® Software — environment
# Copy to .env.local and fill in. Never commit real values.
# ──────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
#
# The anon key is the only one of these two that is required. It is a JWT the
# project signs, and one of its public claims is the project's own reference —
# so the URL below is worked out from it when left unset.
#
# That is deliberate. Two settings that must agree is a design that manufactures
# a failure: paste them from different projects and every request comes back
# "Invalid API key", which names neither. One value cannot disagree with itself.
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Optional. Leave unset unless the project is on a custom domain. If it is set
# and contradicts the anon key, the key's project wins — and /diagnostics says
# so — because a key cannot authenticate against a project it was not issued for.
# NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Server-only. Bypasses Row Level Security — never expose to the browser.
#
# Two uses, both outside a user session:
#   · background jobs (ingestion, radar scans), which re-apply tenant scoping
#     in code;
#   · removing a second factor when somebody redeems a recovery code, which
#     Supabase will not let a session do for itself — that being the bypass the
#     factor exists to prevent.
#
# Without it, two-step sign-in still works and recovery codes cannot be
# redeemed. The platform says so rather than spending the code and failing.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Server-only, and the only setting needed to build the schema.
#
# With this set, /setup applies every migration itself, in one transaction,
# and reports what it built. Without it the schema has to be pasted into the
# SQL editor by hand, which is where a half-applied database comes from.
#
# Take the SESSION POOLER string from Supabase → Settings → Database, not the
# direct one: the direct host resolves to IPv6 only, which most hosting
# platforms cannot route, and the failure is a timeout that names nothing.
#
# It contains the database password. No NEXT_PUBLIC_ prefix, ever.
SUPABASE_DB_URL="postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Public origin, used for auth redirects and share links. In production this is
# the deployment the marketing site's APP_URL points at (docs/app.js).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"    # production: https://amryn.vercel.app

# ── Internal access ───────────────────────────────────────────
# Optional, and worth setting.
#
# /diagnostics and /setup describe the deployment and can change the schema.
# They are closed to everyone except an administrator of an organisation — and
# to a caller holding this token, given as ?key= or an x-internal-key header.
#
# That second route exists for the case the first cannot cover: nobody can sign
# in, and the page explaining why is behind signing in. Without a value set,
# only the administrator route works.
#
# Also unlocks the detail in /api/health. Without it that endpoint returns the
# status word and nothing else, which is all a monitor needs.
#
# Use a long random value: openssl rand -base64 32
INTERNAL_ACCESS_TOKEN=""

# ── Email ─────────────────────────────────────────────────────
# Optional. Without it, invitations still work: the link is shown to whoever
# creates one, to send on themselves. With it, they are emailed automatically.
#
# SMTP rather than one provider's API, so Resend, SendGrid, Postmark, Mailgun
# and a company's own mail server all work. A business already on Microsoft 365
# should not have to sign up for anything.
#
# SMTP_PORT decides TLS: 465 is encrypted from the first byte, 587 and 25 start
# in the clear and upgrade with STARTTLS. Setting the wrong one produces a hang
# rather than a refusal, which is why it is derived rather than configured.
# SMTP_SECURE overrides it for a server that disagrees.
#
# SMTP_FROM must be an address the provider has authorised you to send from, or
# it will be rejected or filed as spam. Verify the domain with them first.
#
# SMTP_PASSWORD is a credential. No NEXT_PUBLIC_ prefix, ever.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASSWORD="<smtp-password>"
SMTP_FROM="Amryn <no-reply@yourdomain.com>"
# SMTP_SECURE="true"

# ── AI provider ───────────────────────────────────────────────
# Optional. With no key the AI layer runs its deterministic analytical
# engines instead, so the platform stays fully usable — only the assistant
# and cross-cutting recommendations are unavailable.
#
# Defaults to OpenAI when a key is set. The model default follows the
# provider, so leave AI_MODEL unset unless you want a specific one.
AI_PROVIDER="anthropic"         # anthropic | openai | none
AI_API_KEY=""                   # console.anthropic.com → API keys

# Leave unset to get the provider's default:
#   anthropic → claude-opus-5
#   openai    → gpt-4.1-mini
#
# OpenAI's reasoning models (o-series, gpt-5) take a different request shape.
# That is handled automatically from the model name — no other setting needed.
AI_MODEL=""

AI_MAX_OUTPUT_TOKENS="16000"

# How hard the model works: low | medium | high | xhigh | max.
# Anthropic only; ignored by OpenAI.
AI_EFFORT="high"

# ── routing the model through a gateway ───────────────────────
# Optional. Set both, or neither.
#
# A Cloudflare AI Gateway speaks the same API as the provider, so pointing at
# one changes nothing above src/lib/ai/provider.ts. What it adds is response
# caching, rate limiting and a log of every request — and it can hold the
# provider credential itself, from a key stored there or from prepaid credits.
#
# In that case there is no AI_API_KEY on this side at all: these two are the
# whole configuration, and the platform treats them as such. Half of the pair
# counts as none of it — an endpoint with no token is refused by the gateway,
# and a token with no endpoint is sent to a provider that has never heard of it.
#
#   AI_BASE_URL="https://gateway.ai.cloudflare.com/v1/<account-id>/<gateway>/anthropic"
AI_BASE_URL=""

# The gateway's own token, not the provider's key. Sent as cf-aig-authorization.
AI_GATEWAY_TOKEN=""

# ── OAuth providers ───────────────────────────────────────────
# Only needed if you enable a provider in supabase/config.toml and push that
# config with the CLI. If you configure providers in the Supabase dashboard
# instead, leave these unset — the dashboard holds the secrets there.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_GOOGLE_SECRET=""
SUPABASE_AUTH_AZURE_CLIENT_ID=""
SUPABASE_AUTH_AZURE_SECRET=""

# ── Serving from a subpath ────────────────────────────────────
# Only needed where the application is not at the root of its domain. On
# app.amryn.ai it is, so leave this unset — a stray prefix breaks every link.
# Inlined at build time, like anything the browser reads.
# AMRYN_BASE_PATH=""

# ── Payment by transfer ───────────────────────────────────────
# There is no card gateway. A customer chooses a plan, is given a reference,
# transfers the money and emails the proof; an operator confirms it at
# /activations and sends back a one-time activation link.
#
# All five are required together. Half a set of banking details is worse than
# none — somebody would pay against an incomplete instruction and the money
# would not arrive — so the billing page shows nothing unless all five are set.
# None of these is a secret: an account number is printed on every invoice a
# business issues.
PAYMENT_ACCOUNT_NAME="Amryn (Pty) Ltd"
PAYMENT_BANK="First National Bank"
PAYMENT_ACCOUNT_NUMBER=""
PAYMENT_BRANCH_CODE="250655"
PAYMENT_PROOF_EMAIL="accounts@yourdomain.com"
# PAYMENT_SWIFT="FIRNZAJJ"          # only needed for payments from abroad

# ── Feature flags ─────────────────────────────────────────────
AMRYN_ENABLE_EXTERNAL_RADAR="false"   # live market scanning connectors
