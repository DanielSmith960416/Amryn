# dependencies
/node_modules
/.pnp
.pnp.*

# next
/.next/
/out/
next-env.d.ts.timestamp

# production
/build

# testing
/coverage

# misc
.DS_Store
*.pem
*.tsbuildinfo

# local env
.env
.env*.local

# supabase local state
/supabase/.branches
/supabase/.temp

# Scratch files written at the repository root while working — commit messages
# passed to `git commit -F`, one-off verification scripts, throwaway harnesses.
# `git add -A` sweeps them in silently, and .commitmsg.txt reached main exactly
# that way. Anything meant to be kept has a real name and a directory.
/.commitmsg*
/.scratch*
/.tmp*
/.*.mjs
/.*.sh

# The bundled worker, built by scripts/build-worker.mjs.
dist/

# Database dumps, written here by scripts/backup.mjs.
#
# The most dangerous thing in this file. A dump is every row of every table,
# customer data included, in one plain-text file — and it lands in the working
# tree of a repository where `git add -A` is routine. The scratch-file note
# above records how .commitmsg.txt reached main; this would be the same
# accident with a data breach at the end of it.
#
# The manifests are ignored with them. They carry no rows, but they name paths
# and row counts, and there is no reason for them to travel either.
/backups/
